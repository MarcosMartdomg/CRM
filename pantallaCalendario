@Composable
fun PantallaCalendario(navController: NavController) {
    // Estructura principal
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.White)
    ) {
        // Header fijo en la parte superior
        pantallaCalendarioHeader(navHostController = navController)
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color.Gray)
                .padding(16.dp)
        ) {
            Column {
                Text(
                    "CALENDARIO",
                    color = Color.White,
                    fontSize = 20.sp,
                    fontWeight = FontWeight.Bold
                )
                Text(
                    "Julio 2024",
                    color = Color.White,
                    fontSize = 16.sp
                )
            }
        }

        // Contenido desplazable
        Column(
            modifier = Modifier
                .weight(1f) // Permite que este bloque sea desplazable entre el header y el footer
                .verticalScroll(rememberScrollState())
                .padding(16.dp)
        ) {
            // Días de la semana
            DiasDeLaSemana()

            Spacer(modifier = Modifier.height(16.dp))

            // Secciones de contenido: Eventos, Tareas y Llamadas
            SeccionEventos()
            Spacer(modifier = Modifier.height(16.dp))
            SeccionTareas()
            Spacer(modifier = Modifier.height(16.dp))
            SeccionLlamadas()
        }

        // Footer fijo en la parte inferior
        pantallaCalendarioFooter(navHostController = navController)
    }
}

@Composable
fun DiasDeLaSemana() {
    Row(
        modifier = Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.SpaceBetween
    ) {
        val dias = listOf("Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom")
        dias.forEach { dia ->
            Text(
                text = dia,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center,
                modifier = Modifier.weight(1f)
            )
        }
    }
}

