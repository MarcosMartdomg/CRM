@Composable
fun PantallaGraficas(navHostController: NavHostController) {
    // State para controlar la imagen de la gráfica seleccionada
    val selectedGraph = remember { mutableStateOf(R.drawable.grafica_barras) } // Grafica de barras por defecto

    // Llamada al Header3 pasando el navHostController
    Header3(navHostController)

    // Column principal con contenido
    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(top = 200.dp), // Añado un padding top para separar del Header
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        // Título de la página
        Text(text = "ANALÍTICAS MENSUALES", style = TextStyle(fontSize = 30.sp, color = Color.Black))

        // Espaciado entre el título y el texto de patrocinador
        Spacer(modifier = Modifier.height(8.dp))

        // Texto de patrocinador
        Text(text = "Sponsored by (c) Lis Data Solutions", style = TextStyle(fontSize = 14.sp, color = Color.Gray))

        // Espaciado entre el texto de patrocinador y la gráfica
        Spacer(modifier = Modifier.height(16.dp))

        // Imagen de gráfica que cambia según la selección del checkbox
        Image(
            painter = painterResource(id = selectedGraph.value), // Usamos el valor del estado para cambiar la imagen
            contentDescription = "Gráfica",
            modifier = Modifier.fillMaxWidth().height(300.dp)
        )

        // Espaciado entre la gráfica y los checkboxes
        Spacer(modifier = Modifier.height(16.dp))

        // Checkboxes para cambiar las gráficas con menos separación
        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            Column {
                CheckboxLabel(
                    text = "Gráfica de barras",
                    onCheckedChange = { selectedGraph.value = R.drawable.grafica_barras }
                )
                CheckboxLabel(
                    text = "Gráfica lineal",
                    onCheckedChange = { selectedGraph.value = R.drawable.grafica_lineal }
                )
            }
            Column {
                CheckboxLabel(
                    text = "Gráfica de valores",
                    onCheckedChange = { selectedGraph.value = R.drawable.grafica_valores }
                )
                CheckboxLabel(
                    text = "Gráfica circular",
                    onCheckedChange = { selectedGraph.value = R.drawable.grafica_circular }
                )
            }
        }

        // Esto asegura que el footer siempre esté al final
        Spacer(modifier = Modifier.weight(1f)) // Empuja todo hacia arriba

        // Llamada al Footer3 pasando el navHostController
        Footer3(navHostController)
    }
}


