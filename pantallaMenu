@Composable
fun PaginaInicio(navHostController: NavHostController) {
    Column(modifier = Modifier.fillMaxSize()) {
        Header(navHostController)

        Spacer(modifier = Modifier.height(16.dp))

        Text(
            text = "Bienvenido",
            style = TextStyle(fontSize = 32.sp, color = Color.Black),
            modifier = Modifier.align(Alignment.CenterHorizontally)
        )

        Spacer(modifier = Modifier.height(16.dp))

        ContenedorPrincipal()

        Spacer(modifier = Modifier.height(32.dp))

        ContenedoresAlineados()
        Footer(navHostController)
    }
}

@Composable
fun Header(navHostController: NavHostController) {
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .height(130.dp) // Altura del encabezado

    ) {
        // Fondo del encabezado
        val headerImage: Painter = painterResource(id = R.drawable.header_image)
        Image(
            painter = headerImage,
            contentDescription = "Encabezado",
            contentScale = ContentScale.Crop,
            modifier = Modifier.fillMaxSize()
        )

        // Contenedor para las imágenes y el texto
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 16.dp) // Espaciado de los bordes
                .padding(top = 80.dp)
            ,
            verticalAlignment = Alignment.CenterVertically, // Centra verticalmente los elementos
            horizontalArrangement = Arrangement.SpaceBetween // Distribuye los elementos a los extremos
        ) {
            // Imagen izquierda
            val leftImage: Painter = painterResource(id = R.drawable.logo_header)
            Image(
                painter = leftImage,
                contentDescription = "Imagen izquierda",
                modifier = Modifier
                    .size(40.dp) // Tamaño de la imagen
            )

            // Texto en el centro
            Text(
                text = "INICIO",
                style = TextStyle(fontSize = 30.sp, color = Color.White),
                modifier = Modifier.weight(1f), // Hace que el texto ocupe el espacio disponible
                textAlign = TextAlign.Center // Centra el texto
            )

            // Imagen derecha (perfil) que navega a la pantalla de perfil al hacer clic
            val rightImage: Painter = painterResource(id = R.drawable.profile)
            Image(
                painter = rightImage,
                contentDescription = "Imagen perfil",
                modifier = Modifier
                    .size(40.dp) // Tamaño de la imagen
                    .clickable {
                        // Al hacer clic en la imagen, navega a la pantalla de perfil
                        navHostController.navigate("pantallaPerfil")
                    }
            )
        }
    }
}

@Composable
fun ContenedorPrincipal() {
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp)
            .height(300.dp) // Ajustar altura si es necesario
    ) {
        val mainImage: Painter = painterResource(id = R.drawable.main_image)
        Image(
            painter = mainImage,
            contentDescription = "Imagen principal",
            contentScale = ContentScale.Crop,
            modifier = Modifier
                .fillMaxSize()
                .clip(RoundedCornerShape(16.dp)) // Aplicar bordes redondeados
                .border(2.dp, Color.Gray, RoundedCornerShape(16.dp)) // Borde externo
        )
    }
}



@Composable
fun ContenedoresAlineados() {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp)
    ) {
        // Primer contenedor (Imagen izquierda y texto)
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .padding(vertical = 8.dp) // Espaciado entre los contenedores
                .border(2.dp, Color.Gray, RoundedCornerShape(16.dp))
                .padding(16.dp) // Espaciado dentro del contenedor
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {
                val leftImage: Painter = painterResource(id = R.drawable.left_image)
                Image(
                    painter = leftImage,
                    contentDescription = "Imagen izquierda",
                    modifier = Modifier
                        .size(100.dp)
                        .padding(end = 8.dp) // Espaciado entre la imagen y el texto

                )
                // Usar Column para permitir que el texto se divida en varias líneas
                Column(
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text(
                        text = stringResource(id = R.string.texto_izquierda),
                        style = TextStyle(fontSize = 11.sp),
                        modifier = Modifier.padding(bottom = 8.dp),
                        maxLines = Int.MAX_VALUE, // Permite múltiples líneas
                        overflow = TextOverflow.Ellipsis // Corregido: uso adecuado de TextOverflow
                    )
                }
            }
        }

        // Segundo contenedor (Imagen derecha y texto)
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .padding(vertical = 8.dp) // Espaciado entre los contenedores
                .border(2.dp, Color.Gray, RoundedCornerShape(16.dp))
                .padding(16.dp) // Espaciado dentro del contenedor
        ) {
            Row(
                verticalAlignment = Alignment.Top, // Alinea el contenido al principio
                horizontalArrangement = Arrangement.Start // Alinea la imagen a la izquierda
            ) {
                // Usar Column para permitir que el texto se divida en varias líneas
                Column(
                    modifier = Modifier
                        .weight(1f) // Deja que el texto ocupe el espacio disponible
                        .padding(end = 8.dp) // Espaciado entre la imagen y el texto
                        .padding(top = 16.dp)
                ) {
                    Text(
                        text = stringResource(id = R.string.texto_derecha),
                        style = TextStyle(fontSize = 11.sp),
                        maxLines = Int.MAX_VALUE,  // Permite múltiples líneas
                        overflow = TextOverflow.Clip // El texto se ajusta a las líneas sin puntos suspensivos
                    )
                }

                // Imagen de la derecha
                val rightImage: Painter = painterResource(id = R.drawable.right_image)
                Image(
                    painter = rightImage,
                    contentDescription = "Imagen derecha",
                    modifier = Modifier.size(100.dp)
                )
            }
        }

    }
}
@Composable
fun Footer(navHostController: NavHostController) {
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .height(130.dp) // Altura del footer
            .padding(top = 16.dp) // Espaciado superior para que no se pegue al contenido
    ) {
        val footerImage: Painter = painterResource(id = R.drawable.header_image) // Usa la misma imagen del header
        Image(
            painter = footerImage,
            contentDescription = "Fondo del footer",
            contentScale = ContentScale.Crop,
            modifier = Modifier.fillMaxSize()
        )

        // Contenedor de las imágenes alineadas horizontalmente
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .align(Alignment.BottomCenter) // Alineamos al fondo del Box
                .padding(horizontal = 16.dp)
                .padding(bottom = 16.dp),// Espaciado lateral
            horizontalArrangement = Arrangement.SpaceBetween // Espaciado entre las imágenes
        ) {
            // Imágenes en el footer
            Image(
                painter = painterResource(id = R.drawable.home), // Imagen home
                contentDescription = "Home",
                modifier = Modifier.size(40.dp)
            )
            Image(
                painter = painterResource(id = R.drawable.calendar), // Imagen calendario
                contentDescription = "Calendar",
                modifier = Modifier.size(40.dp)
            )
            Image(
                painter = painterResource(id = R.drawable.almacen), // Imagen almacen
                contentDescription = "Almacen",
                modifier = Modifier.size(40.dp)
            )
            Image(
                painter = painterResource(id = R.drawable.graficas), // Imagen graficas
                contentDescription = "Graficas",
                modifier = Modifier
                    .size(40.dp)
                    .clickable {
                        // Al hacer clic en la imagen de gráficas, navega a la pantalla de gráficas
                        navHostController.navigate("pantallaGraficas")
                    }
            )
            Image(
                painter = painterResource(id = R.drawable.ajustes), // Imagen ajustes
                contentDescription = "Ajustes",
                modifier = Modifier.size(40.dp)
                    .clickable {
                        // Al hacer clic en la imagen de gráficas, navega a la pantalla de gráficas
                        navHostController.navigate("pantallaAjustes")
                    }
            )
        }
    }
}

