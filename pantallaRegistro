@Composable
fun PantallaIdioma(navController: NavController) {
    val infiniteTransition = rememberInfiniteTransition()
    val alphaAnimation = infiniteTransition.animateFloat(
        initialValue = 0.3f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(durationMillis = 1000, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        )
    )

    Surface(
        modifier = Modifier.fillMaxSize()
    ) {
        Box(
            contentAlignment = Alignment.Center,
            modifier = Modifier.fillMaxSize()
        ) {
            Image(
                painter = painterResource(R.drawable.fondo1),
                contentDescription = "Pantalla de carga",
                modifier = Modifier.fillMaxSize()
            )
            Column(
                verticalArrangement = Arrangement.Center,
                horizontalAlignment = Alignment.CenterHorizontally,
                modifier = Modifier
                    .fillMaxSize()
                    .padding(16.dp)
            ) {
                Image(
                    painter = painterResource(R.drawable.logoz),
                    contentDescription = null,
                    modifier = Modifier.size(100.dp)
                )

                Spacer(modifier = Modifier.size(75.dp))

                Text(
                    text = "ZIPPI",
                    color = Color.White,
                    fontSize = 42.sp,
                    fontWeight = FontWeight.Bold,
                )

                Spacer(modifier = Modifier.size(15.dp))

                Text(
                    text = "INSPIRADOS POR TI",
                    color = Color.White,
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Thin,
                )

                Spacer(modifier = Modifier.size(50.dp))

                Button(
                    onClick = { navController.navigate("pantallaMenu") },
                    colors = ButtonDefaults.buttonColors(containerColor = Color.White),
                    modifier = Modifier
                        .height(75.dp)
                        .width(300.dp)
                        .padding(8.dp),
                    contentPadding = PaddingValues(16.dp)
                ) {
                    Text(
                        text = "Comenzar",
                        color = Color(0xFF0665B7),
                        fontSize = 24.sp,
                        fontWeight = FontWeight.Bold,
                        style = TextStyle.Default
                    )
                }

                Spacer(modifier = Modifier.size(50.dp))

                // Lista desplegable en lugar del segundo botón
                Desplegable(navController)
            }
        }
    }
}

@Composable
fun Desplegable(navController: NavController) {
    var expanded by remember { mutableStateOf(false) }
    var selectedOption by remember { mutableStateOf("Language") }
    val opciones = listOf("Spanish", "English") // Define tus opciones

    Box(
        modifier = Modifier
            .fillMaxWidth(),
        contentAlignment = Alignment.Center
    ) {
        // Botón estilo desplegable
        Button(
            onClick = { expanded = !expanded },
            colors = ButtonDefaults.buttonColors(containerColor = Color.White),
            modifier = Modifier
                .height(60.dp)
                .width(280.dp),
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {
                Image(
                    painter = painterResource(R.drawable.iconoidioma),
                    contentDescription = null,
                    modifier = Modifier
                        .size(50.dp)
                        .padding(end = 17.dp)
                )
                Text(
                    text = selectedOption,
                    color = Color(0xFF0665B7),
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold,
                    style = TextStyle.Default
                )
            }


        }

        // Menú desplegable
        DropdownMenu(
            expanded = expanded,
            onDismissRequest = { expanded = false },
            modifier = Modifier
                .width(300.dp)
        ) {
            opciones.forEach { opcion ->
                DropdownMenuItem(
                    text = {
                        Text(
                            text = opcion,
                            fontSize = 20.sp,
                            color = Color(0xFF0665B7),
                            fontWeight = FontWeight.Medium
                        )
                    },
                    onClick = {
                        selectedOption = opcion
                        expanded = false
                        when (opcion) {
                            "Opción 1" -> navController.navigate("pantallaMenu")
                            "Opción 2" -> navController.navigate("pantallaMenu")
                        }
                    },
                    modifier = Modifier
                        .padding(vertical = 4.dp)
                )
            }
        }
    }
}
