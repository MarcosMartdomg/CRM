@Composable
fun PantallaPerfil(navHostController: NavHostController) {
    // Llamada a la estructura de la pantalla
    Column(modifier = Modifier.fillMaxSize()) {
        PantallaPerfilHeader(navHostController) // Llamamos al header vacío
        ContenedorConCirculos() // Llamamos al contenedor con los círculos e imágenes
        ApartadosConfiguracion() // Llamamos a los apartados de configuración
        pantallaPerfilFooter(Modifier,navHostController)
    }

}



@Composable
fun ContenedorConCirculos() {
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp)
            .padding(top = 32.dp) // Espacio hacia abajo del header
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .border(2.dp, Color.Gray, RoundedCornerShape(16.dp))
                .padding(16.dp)
        ) {
            Row(
                horizontalArrangement = Arrangement.SpaceEvenly,
                modifier = Modifier.fillMaxWidth()
            ) {
                // Primer círculo
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Box(
                        modifier = Modifier
                            .size(80.dp)
                            .clip(CircleShape)
                            .background(Color(0xFFADD8E6))
                            .padding(8.dp)
                    ) {
                        val image: Painter = painterResource(id = R.drawable.llamar)
                        Image(
                            painter = image,
                            contentDescription = "Home",
                            modifier = Modifier.fillMaxSize()
                        )
                    }
                    Text(text = "Llamar", style = TextStyle(fontSize = 12.sp))
                }

                // Segundo círculo
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Box(
                        modifier = Modifier
                            .size(80.dp)
                            .clip(CircleShape)
                            .background(Color(0xFFADD8E6))
                            .padding(8.dp)
                    ) {
                        val image: Painter = painterResource(id = R.drawable.email)
                        Image(
                            painter = image,
                            contentDescription = "Calendar",
                            modifier = Modifier.fillMaxSize()
                        )
                    }
                    Text(text = "Email", style = TextStyle(fontSize = 12.sp))
                }

                // Tercer círculo
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Box(
                        modifier = Modifier
                            .size(80.dp)
                            .clip(CircleShape)
                            .background(Color(0xFFADD8E6))
                            .padding(8.dp)
                    ) {
                        val image: Painter = painterResource(id = R.drawable.edit)
                        Image(
                            painter = image,
                            contentDescription = "Almacen",
                            modifier = Modifier.fillMaxSize()
                        )
                    }
                    Text(text = "Editar", style = TextStyle(fontSize = 12.sp))
                }
            }
        }
    }
}

@Composable
fun ApartadosConfiguracion() {
    // Espacio entre los círculos y los apartados de configuración
    Spacer(modifier = Modifier.height(50.dp))

    // Apartados de configuración
    Column(modifier = Modifier.padding(horizontal = 16.dp)) {
        ConfigOption(text = "Tareas")
        ConfigOption(text = "Notas")
        ConfigOption(text = "Reuniones")
        ConfigOption(text = "Historial de llamadas")
    }
}

@Composable
fun ConfigOption(text: String) {
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 18.dp)
            .border(1.dp, Color.Gray, RoundedCornerShape(8.dp))
            .padding(16.dp)
    ) {
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(text = text, style = TextStyle(fontSize = 16.sp))
            Icon(
                imageVector = Icons.Filled.ArrowForward,
                contentDescription = "Flecha",
                modifier = Modifier.size(24.dp)
            )
        }
    }
}
